IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/luckywheel.ico"
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "kaido-MSVC\0"
      VALUE "FileDescription", "LuckyWheel\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 kaido-MSVC. MIT License.\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "ProductName", "LuckyWheel\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
